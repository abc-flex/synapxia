---
import { t } from "@/i18n";
import DataTableCellValue from "./DataTableCellValue.astro";
import type { TreeRowMeta } from "@/lib/datatable";
import type { ColumnConfig } from "@/types/datatable";

interface Props {
  col: ColumnConfig;
  row: Record<string, any>;
  locale: string;
  /** Tree mode, first visible column only: indent by depth + expand/collapse toggle. */
  tree?: TreeRowMeta | null;
}
const { col, row, locale, tree = null } = Astro.props as Props;
// Roots start expanded (so the second level shows); deeper levels start collapsed.
// advancedTable.ts owns the state from then on.
const expanded = tree ? tree.depth === 0 : false;
---
<td class="px-2 py-1" data-label={t(locale, col.label)} data-col={col.as ?? "text"}>
  {tree ? (
    <div class="dt-tree" style={`padding-left: ${tree.depth * 1.5}rem`}>
      {tree.hasChildren ? (
        <button
          type="button"
          class="dt-tree-toggle"
          data-tree-toggle={tree.id}
          aria-expanded={expanded ? "true" : "false"}
          title={t(locale, "data_table.expand_collapse")}
          aria-label={t(locale, "data_table.expand_collapse")}
          data-i18n-title="data_table.expand_collapse"
          data-i18n-aria-label="data_table.expand_collapse"
        >
          <span aria-hidden="true">{expanded ? "−" : "+"}</span>
        </button>
      ) : (
        <span class="dt-tree-spacer" aria-hidden="true"></span>
      )}
      <div class="min-w-0">
        <DataTableCellValue col={col} row={row} locale={locale} />
      </div>
    </div>
  ) : (
    <DataTableCellValue col={col} row={row} locale={locale} />
  )}
</td>
