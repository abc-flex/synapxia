---
/**
 * Options — every active module with its options, laid out like the
 * privilege checklist: the module in each section header, its options as
 * rows (OptionCatalog.svelte).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/core/Breadcrumb.astro";
---

<BaseLayout>
  <div class="mx-auto w-full max-w-full md:p-0">
    <Breadcrumb
      moduleName="Administration"
      pageName="Options"
      pageTitle="Options"
      homeLink="/"
      moduleNameKey="modules.ADMIN"
      pageNameKey="menu_options.options"
      pageTitleKey="menu_options.options"
    />

    <div id="option-catalog-root"></div>
  </div>

  <script>
    // Mount the Svelte component manually (bundled @/ script, no island codegen).
    import { mount } from "svelte";
    import OptionCatalog from "@/components/svelte/OptionCatalog.svelte";

    const root = document.getElementById("option-catalog-root");
    if (root) mount(OptionCatalog, { target: root, props: {} });
  </script>
</BaseLayout>
