---
// The `as`-dispatch renderer for one cell's content (the <td> lives in
// DataTableCell.astro, which may wrap this in a tree indent + toggle).
import checkSvg from "@/images/icons/check.svg?raw";
import { statusTone, formatDate, formatRelative, renderSubtitle } from "@/lib/datatable";
import { listLabelsAttr } from "@/lib/listLang";
import { iconSvg } from "@/lib/profileIcons";
import type { ColumnConfig } from "@/types/datatable";

interface Props {
  col: ColumnConfig;
  row: Record<string, any>;
  locale: string;
}
const { col, row, locale } = Astro.props as Props;
// List-backed column → every language's label, so the cell follows the
// language switcher (relabelLists in lib/listLang.ts).
const listLabels = col.labelsKey ? listLabelsAttr(row[col.labelsKey]) : undefined;
const titleIcon = col.as === "title" && col.iconKey ? iconSvg(row[col.iconKey]) : "";
const textIcon = !col.as && col.iconKey ? iconSvg(row[col.iconKey]) : "";
---
{col.as === "title" && titleIcon ? (
  <div class="flex items-center gap-3">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-300 [&>svg]:size-5" aria-hidden="true">
      <Fragment set:html={titleIcon} />
    </span>
    <div class="min-w-0">
      <span class="dt-title">
        {row[col.key]}
        {col.titleSecondaryKey && row[col.titleSecondaryKey] && (
          <span class="dt-title-secondary">{row[col.titleSecondaryKey]}</span>
        )}
      </span>
      {col.subtitleKey && renderSubtitle(col, row, locale) && (
        <span class="dt-subtitle">{renderSubtitle(col, row, locale)}</span>
      )}
    </div>
  </div>
) : col.as === "title" ? (
  <>
    <span class="dt-title">
      {row[col.key]}
      {col.titleSecondaryKey && row[col.titleSecondaryKey] && (
        <span class="dt-title-secondary">{row[col.titleSecondaryKey]}</span>
      )}
    </span>
    {col.subtitleKey && renderSubtitle(col, row, locale) && (
      <span class="dt-subtitle">{renderSubtitle(col, row, locale)}</span>
    )}
  </>
) : col.as === "status" && row[col.key] ? (
  <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${statusTone(row[col.key])}`}
    data-list-labels={listLabels}>
    {row[col.key]}
  </span>
) : col.as === "tags" ? (
  <span class="flex flex-wrap gap-1.5">
    {String(row[col.key] ?? "")
      .split(",")
      .map((tg) => tg.trim())
      .filter(Boolean)
      .map((tag) => (
        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
          {tag}
        </span>
      ))}
  </span>
) : col.as === "date" ? (
  col.dateFormat === "relative" ? formatRelative(row[col.key], locale) : formatDate(row[col.key], locale)
) : col.as === "badge" && row[col.key] ? (
  <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300"
    data-list-labels={listLabels}>
    {row[col.key]}
  </span>
) : col.as === "boolean" || row[col.key] === true || row[col.key] === "true" ? (
  row[col.key] === true || row[col.key] === "true" ? (
    <span class="w-5 h-5 inline-block text-blue-600">
      <Fragment set:html={checkSvg} />
    </span>
  ) : (
    ""
  )
) : textIcon ? (
  <span class="inline-flex items-center gap-2">
    <span class="h-5 w-5 shrink-0 text-indigo-600 dark:text-indigo-300 [&>svg]:h-5 [&>svg]:w-5" aria-hidden="true">
      <Fragment set:html={textIcon} />
    </span>
    <span>{row[col.key]}</span>
  </span>
) : listLabels ? (
  <span data-list-labels={listLabels}>{row[col.key]}</span>
) : (
  row[col.key]
)}
