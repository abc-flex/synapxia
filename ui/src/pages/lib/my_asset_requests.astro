---
/**
 * My Asset Requests — the durable record of every asset the caller has taken
 * part in: requests directed at them plus assets they proposed, open and closed.
 *
 * The table is the `MyAssetRequests.svelte` island, mounted manually via
 * Svelte 5's `mount()` from a bundled `<script>` (not the @astrojs/svelte island
 * mechanism — see astro.config.mjs). It was a server-rendered table before, but
 * an SSR snapshot is stale the moment a review is decided anywhere, which is the
 * exact defect this feature fixes; the island subscribes to the shared
 * notifications store instead, so this page and the header bell always agree.
 *
 * Absorbs the former `/lib/modifications` page, which listed a single request
 * type and was already unreachable from every menu.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumb from "@/components/core/Breadcrumb.astro";
import { getLocale } from "@/utils/getLocale";
import { t } from "@/i18n";

const locale = getLocale(Astro);
---

<BaseLayout title="My Asset Requests">
  <div class="mx-auto w-full max-w-full md:p-0">
    <Breadcrumb
      moduleName="AI Library"
      pageName="My Asset Requests"
      pageTitle="My Asset Requests"
      homeLink="/"
      moduleNameKey="modules.LIB"
      pageNameKey="menu_options.my_asset_requests"
      pageTitleKey="menu_options.my_asset_requests"
    />

    <p
      class="mb-4 text-sm text-gray-500 dark:text-gray-400"
      data-i18n="my_asset_requests.subtitle"
    >
      {t(locale, "my_asset_requests.subtitle")}
    </p>

    <div id="my-asset-requests-root"></div>
  </div>

  <script>
    // Mount the Svelte component manually (bundled @/ script, no island codegen).
    import { mount } from "svelte";
    import MyAssetRequests from "@/components/svelte/MyAssetRequests.svelte";

    const target = document.getElementById("my-asset-requests-root");
    if (target) mount(MyAssetRequests, { target });
  </script>
</BaseLayout>
