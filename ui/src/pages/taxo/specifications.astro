---
/**
 * Specifications — the one place to define what a category characterizes.
 *
 * `?category=CODE` (the Categories list links here per row) opens that
 * category's checklist: every active feature, grouped by feature type, with
 * Included / order / default value / Required / Copyable per feature
 * (SpecificationMatrix.svelte). Without `?category=` the island opens the
 * first category.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/core/Breadcrumb.astro";

const category = Astro.url.searchParams.get("category") ?? "";
---

<BaseLayout>
  <div class="mx-auto w-full max-w-full md:p-0">
    <Breadcrumb
      moduleName="Asset Taxonomy"
      pageName="Specifications"
      pageTitle="Specifications"
      homeLink="/"
      moduleNameKey="modules.TAXO"
      masterKey="menu_options.categories"
      pageNameKey="menu_options.specifications"
      pageTitleKey="menu_options.specifications"
    />

    <div id="specification-matrix-root" data-category={category}></div>
  </div>

  <script>
    // Mount the Svelte component manually (bundled @/ script, no island codegen).
    import { mount } from "svelte";
    import SpecificationMatrix from "@/components/svelte/SpecificationMatrix.svelte";

    const root = document.getElementById("specification-matrix-root");
    if (root) mount(SpecificationMatrix, { target: root, props: { category: root.dataset.category ?? "" } });
  </script>
</BaseLayout>
