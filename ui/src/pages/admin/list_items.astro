---
/**
 * List Items — a list's values with their label in every language.
 *
 * `?list=CODE` (the Lists page links here per row) opens that list as one
 * editable table: value, order and a label per language
 * (ListValueMatrix.svelte). Without `?list=` the island opens the first list.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/core/Breadcrumb.astro";

const list = Astro.url.searchParams.get("list") ?? "";
---

<BaseLayout>
  <div class="mx-auto w-full max-w-full md:p-0">
    <Breadcrumb
      moduleName="Administration"
      pageName="List Items"
      pageTitle="List Items"
      homeLink="/"
      moduleNameKey="modules.ADMIN"
      masterKey="menu_options.lists"
      pageNameKey="menu_options.list_items"
      pageTitleKey="menu_options.list_items"
    />

    <div id="list-value-matrix-root" data-list={list}></div>
  </div>

  <script>
    // Mount the Svelte component manually (bundled @/ script, no island codegen).
    import { mount } from "svelte";
    import ListValueMatrix from "@/components/svelte/ListValueMatrix.svelte";

    const root = document.getElementById("list-value-matrix-root");
    if (root) mount(ListValueMatrix, { target: root, props: { list: root.dataset.list ?? "" } });
  </script>
</BaseLayout>
