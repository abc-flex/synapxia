---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/core/Breadcrumb.astro";
import Toast from "../../components/Toast.astro";
import ComingSoon from "../../components/ComingSoon.astro";
import CardGallery from "../../components/lib/gallery/CardGallery.astro";
import ExploreCard from "../../components/lib/ExploreCard.astro";
import ExploreDetailModal from "../../components/lib/ExploreDetailModal.astro";
import { getAssetsByCategoryWithAccess } from "@/lib/assets";
import { getOption } from "@/lib/options";
import { getCurrentUser } from "@/lib/auth";
import { getFavoritesByUser } from "@/lib/favorites";
import { getActions, summarizeVotes } from "@/lib/actions";
import { summarizeDiscussionCounts } from "@/lib/foro";
import { getLocale } from "@/utils/getLocale";
import { formatRelative } from "@/lib/datatable";

const locale = getLocale(Astro);
const params = Astro.url.searchParams;
const CATEGORY = params.get("code") ?? "";

// Every AI Library category links here with its own `?code=`; there is no
// picker mode anymore (retired alongside the LIB.EXPLORE sidebar option — see
// memory/CHANGELOG.md). A bare `/lib/explore` has nothing to show.
if (!CATEGORY) {
  return Astro.redirect("/");
}

let categoryName = params.get("name") ?? "";
let categoryIcon = params.get("icon") ?? "";

// name/icon are optional overrides for callers that already have them.
// Resolve them from the option itself so they always match the sidebar's
// current values for that option.
if (!categoryName || !categoryIcon) {
  try {
    const opt = await getOption("LIB", CATEGORY);
    categoryName = categoryName || opt.name;
    categoryIcon = categoryIcon || opt.icon || "search";
  } catch {
    // Unknown code — fall through, the category fetch below will surface the error.
  }
}
if (!categoryIcon) categoryIcon = "search";

// Privileges/Permisos filter (mirrors `/lib/assets`'s toolbar filter, HU-LI08)
// — no "all" option: the gallery always shows exactly one scope at a time,
// defaulting to PUBLIC (listed first, which is also the <select>'s default).
const PRIVILEGE_OPTIONS = [
  { value: "PUBLIC", label: "Public", i18n: "asset_table.perm_filter_public" },
  { value: "USER", label: "Shared with me", i18n: "asset_table.perm_filter_user" },
  { value: "ROLE", label: "My role", i18n: "asset_table.perm_filter_role" },
  { value: "TEAM", label: "My team", i18n: "asset_table.perm_filter_team" },
  { value: "UNIT", label: "My unit", i18n: "asset_table.perm_filter_unit" },
  { value: "PROJECT", label: "My projects", i18n: "asset_table.perm_filter_project" },
];

// ── Assets in the selected category ─────────────────────────────────────────
let errorMessage: string | null = null;
let assets: any[] = [];
try {
  // Access-scoped (HU-LI08): only assets a grant reaches the caller through
  // are returned, each carrying `permission_scopes` for the privileges
  // filter below. Bumped limit (vs. the default 100) since this now doubles
  // as the page's only fetch for the category.
  assets = await getAssetsByCategoryWithAccess(CATEGORY, 0, 500);
} catch (error) {
  console.error(`Failed to fetch assets for category ${CATEGORY}:`, error);
  errorMessage = error instanceof Error ? error.message : "Failed to fetch assets from API";
  assets = [];
}

let favIds = new Set<number>();
let myUserId: number | null = null;
try {
  const me = await getCurrentUser();
  myUserId = Number(me.id);
  const favs = await getFavoritesByUser(myUserId);
  favIds = new Set(favs.map((f) => Number(f.asset)));
} catch {
  favIds = new Set();
}

let votesByAsset: Map<number, { score: number; positive: number; negative: number; myVote: string | null }> = new Map();
let discussByAsset = new Map<number, number>();
try {
  const allActions = await getActions(0, 1000);
  votesByAsset = summarizeVotes(allActions, myUserId ?? undefined);
  discussByAsset = summarizeDiscussionCounts(allActions);
} catch {
  votesByAsset = new Map();
  discussByAsset = new Map();
}

const isPublished = (raw: unknown): boolean =>
  String(raw ?? "").replace(/^\d+-/, "").toUpperCase() === "PUBLISHED";

const rows = assets.filter((item) => isPublished(item.status)).map((item) => {
  const tags = Array.isArray(item.tags) ? item.tags : [];
  return {
    id: item.id,
    name: item.name,
    description: item.description ?? "",
    subtitle: formatRelative(item.updated_at ?? item.created_at, locale),
    subtitleTs: item.updated_at ?? item.created_at,
    statusValue: item.status,
    favorite: favIds.has(item.id) ? "yes" : "no",
    votePositive: votesByAsset.get(Number(item.id))?.positive ?? 0,
    voteNegative: votesByAsset.get(Number(item.id))?.negative ?? 0,
    myVote: votesByAsset.get(Number(item.id))?.myVote ?? "",
    discussCount: discussByAsset.get(Number(item.id)) ?? 0,
    tags,
    version: item.current_version ?? "1.0.0",
    searchText: [item.name, item.description, tags.join(" ")].filter(Boolean).join(" "),
    // Comma-separated scope-types by which the current user is granted
    // access — drives the toolbar's privileges filter (columnFilter4's
    // gallery counterpart).
    permissions: (item.permission_scopes ?? []).join(","),
  };
});

// A category with no published assets yet (e.g. the still-unimplemented
// Agentic Flows/Skills/Assistants/RAG Apps/Models catalogs) shows the same
// "coming soon" placeholder every other unbuilt route falls back to, instead
// of an empty gallery.
const hasAssets = rows.length > 0;
---

<BaseLayout>
  {errorMessage && <Toast message={errorMessage} variant="error" open={true} />}

  <div class="mx-auto w-full max-w-full">
    <Breadcrumb
      moduleName="AI Library"
      pageName={categoryName}
      pageTitle={categoryName}
      homeLink="/"
      moduleNameKey="modules.LIB"
    />

    {!hasAssets ? (
      <ComingSoon />
    ) : (
      <Fragment>
        {/* Read-only "big card" view (opened by a whole-card click) */}
        <ExploreDetailModal modalId="explore-view-modal" icon={categoryIcon} categoryLabel={categoryName} />

        <CardGallery
          galleryId="explore-gallery"
          emptyKey="explore_modal.empty"
          statuses={[]}
          privileges={PRIVILEGE_OPTIONS}
          growSearch={false}
          proposeHref={`/lib/propose?category=${CATEGORY}`}
        >
          {rows.map((r) => (
            <ExploreCard
              id={r.id}
              name={r.name}
              subtitle={r.subtitle}
              subtitleTs={r.subtitleTs}
              description={r.description}
              statusValue={r.statusValue}
              favorite={r.favorite}
              searchText={r.searchText}
              permissions={r.permissions}
              icon={categoryIcon}
              tags={r.tags}
              votable={true}
              votePositive={r.votePositive}
              voteNegative={r.voteNegative}
              myVote={r.myVote}
              discussCount={r.discussCount}
              version={r.version}
            />
          ))}
        </CardGallery>
      </Fragment>
    )}
  </div>

  <script>
    // Bundled module (Astro resolves @/ + TS and dedupes it). We deliberately
    // avoid the inline `<script type="module">` + `/src/...` import pattern,
    // which 404s in the production build (see memory/CHANGELOG.md 2026-06-15).
    import { initCardGallery } from "@/lib/catalogGallery";
    import { loadClientTranslations } from "@/utils/i18nClient";
    import { installGlobalToast } from "@/lib/toast";

    initCardGallery({ galleryId: "explore-gallery", pageSize: 12 });
    loadClientTranslations();

    // Top-layer toast: renders above the native <dialog> detail modal (a plain
    // body-appended toast loses to the modal's browser top layer).
    installGlobalToast();
  </script>
</BaseLayout>
