---
/**
 * Privileges — the one place to define what a profile may use.
 *
 * `?profile=CODE` (the Profiles list links here per row) opens that profile's
 * checklist: every active option of every active module, with Access / Edit
 * per option (PrivilegeMatrix.svelte). Without `?profile=` the island opens
 * the first profile.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/core/Breadcrumb.astro";

const profile = Astro.url.searchParams.get("profile") ?? "";
---

<BaseLayout>
  <div class="mx-auto w-full max-w-full md:p-0">
    <Breadcrumb
      moduleName="Administration"
      pageName="Privileges"
      pageTitle="Privileges"
      homeLink="/"
      moduleNameKey="modules.ADMIN"
      masterKey="menu_options.profiles"
      pageNameKey="menu_options.privileges"
      pageTitleKey="menu_options.privileges"
    />

    <div id="privilege-matrix-root" data-profile={profile}></div>
  </div>

  <script>
    // Mount the Svelte component manually (bundled @/ script, no island codegen).
    import { mount } from "svelte";
    import PrivilegeMatrix from "@/components/svelte/PrivilegeMatrix.svelte";

    const root = document.getElementById("privilege-matrix-root");
    if (root) mount(PrivilegeMatrix, { target: root, props: { profile: root.dataset.profile ?? "" } });
  </script>
</BaseLayout>
