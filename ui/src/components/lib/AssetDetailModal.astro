---
/**
 * AssetDetailModal — wider create/edit modal for the Asset Repository.
 *
 * Renders the asset's core fields on top, then dynamically appends
 * one input per Feature defined by the chosen category's specifications.
 *
 * USAGE (from a page):
 *   <AssetDetailModal modalId="asset-detail-modal" />
 *
 *   <button data-modal-open="asset-detail-modal"
 *           data-asset-mode="create">+ New asset</button>
 *
 *   <button data-modal-open="asset-detail-modal"
 *           data-asset-mode="edit"
 *           data-asset-id="42">Edit</button>
 *
 *   The page should listen for the `asset-detail-saved` window event
 *   (or just reload). The modal does its own toasting + reload.
 */
interface Props {
  modalId?: string;
  categories?: { value: string; label: string }[];
  statuses?: { value: string; label: string }[];
}

const {
  modalId = "asset-detail-modal",
  categories = [],
  statuses = [],
} = Astro.props as Props;
---

<dialog
  id={modalId}
  class="rounded-2xl p-0 w-[min(1040px,95vw)] max-w-none bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 backdrop:bg-black/60 backdrop:backdrop-blur-sm"
>
  {/* Fixed height so switching the Characterizations / Related / Permissions
      tabs doesn't resize/re-center the dialog — only the body scrolls. */}
  <form id={`${modalId}-form`} class="flex flex-col h-[min(760px,90vh)]">
    {/* ============== Header ============== */}
    <div class="flex items-start justify-between gap-4 px-6 py-4 border-b border-gray-200 dark:border-gray-800">
      <div>
        <h3
          id={`${modalId}-title`}
          class="text-lg font-bold text-gray-900 dark:text-white"
        >
          <span
            id={`${modalId}-title-text`}
            data-i18n="asset_detail_modal.title_create"
          >New Asset</span
          >{/* Edit mode appends ": <asset name>" right after the title, same
               font/size — no separate line. */}<span id={`${modalId}-title-name`}></span>
        </h3>
        {/* Current version badge — filled + shown only in edit mode. Sits on
            its own line below the title (was previously inline beside it). */}
        <span
          id={`${modalId}-version`}
          class="hidden mt-1 inline-block rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-semibold text-indigo-700 dark:bg-indigo-500/20 dark:text-indigo-300"
          title="Current version"
          data-i18n-title="asset_detail_modal.current_version"
        ></span>
      </div>
      <div class="flex items-center gap-1">
        <button
          type="button"
          id={`${modalId}-fav`}
          aria-pressed="false"
          title="Add to favorites"
          data-i18n-title="asset_detail_modal.favorite_add"
          class="rounded-md p-1.5 text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        >
          <svg
            class="w-5 h-5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.3 4.02a1 1 0 00.95.69h4.22c.97 0 1.37 1.24.59 1.81l-3.42 2.48a1 1 0 00-.36 1.12l1.3 4.02c.3.92-.75 1.69-1.54 1.12l-3.41-2.48a1 1 0 00-1.18 0l-3.41 2.48c-.78.57-1.84-.2-1.54-1.12l1.3-4.02a1 1 0 00-.36-1.12L2 9.45c-.78-.57-.38-1.81.6-1.81h4.21a1 1 0 00.95-.69l1.3-4.02z"
            />
          </svg>
        </button>
        <button
          type="button"
          data-modal-close={modalId}
          class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-800"
          aria-label="Close"
          data-i18n-aria-label="common.close"
        >
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
        </button>
      </div>
    </div>

    {/* ============== Status banner ============== */}
    <div
      id={`${modalId}-status`}
      class="hidden mx-6 mt-4 rounded-lg p-3 text-sm"
      role="status"
      aria-live="polite"
    >
    </div>

    {/* ============== Body (scrollable) ============== */}
    <div class="flex-1 overflow-y-auto px-6 pb-5 space-y-6">
      <input type="hidden" name="id" id={`${modalId}-id`} />

      {/* ============== Core fields ============== */}
      {/* Re-parented into AssetDetailTabs' "core" tab panel by the script below
          right after mount — this <section> stays the single source of truth
          for the core-field inputs/validation/save payload, just relocated
          into the tab flow instead of being a permanently-visible sibling. */}
      <section id={`${modalId}-core-section`}>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div class="md:col-span-2">
            <label
              for={`${modalId}-name`}
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
            ><span data-i18n="asset_modal.name">Name</span><span class="ml-0.5 text-red-500" aria-hidden="true">*</span></label>
            <input
              id={`${modalId}-name`}
              name="name"
              type="text"
              required
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white"
            />
          </div>

          <div>
            <label
              for={`${modalId}-category`}
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
            ><span data-i18n="asset_modal.category">Category</span><span class="ml-0.5 text-red-500" aria-hidden="true">*</span></label>
            <select
              id={`${modalId}-category`}
              name="category"
              required
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white"
            >
              <option value="" data-i18n="asset_detail_modal.choose_category">— choose —</option>
              {categories.map((c) => (
                <option value={c.value}>{c.label}</option>
              ))}
            </select>
          </div>

          <div>
            <label
              for={`${modalId}-status`}
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
            ><span data-i18n="asset_modal.status">Status</span><span class="ml-0.5 text-red-500" aria-hidden="true">*</span></label>
            <select
              id={`${modalId}-status-select`}
              name="status"
              required
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white"
            >
              <option value="" data-i18n="asset_detail_modal.choose_status">— choose —</option>
              {statuses.map((s) => (
                <option value={s.value}>{s.label}</option>
              ))}
            </select>
          </div>

          <div class="md:col-span-2">
            <label
              for={`${modalId}-description`}
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
              data-i18n="asset_modal.description"
            >Description</label>
            <textarea
              id={`${modalId}-description`}
              name="description"
              rows={2}
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white"
            ></textarea>
          </div>

          <div>
            <label
              for={`${modalId}-reference`}
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
              data-i18n="asset_modal.reference"
            >Reference</label>
            <input
              id={`${modalId}-reference`}
              name="reference"
              type="text"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white"
            />
          </div>

          <div>
            <label
              for={`${modalId}-tags`}
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
              data-i18n="asset_modal.tags"
            >Tags</label>
            <input
              id={`${modalId}-tags`}
              name="tags"
              type="text"
              placeholder="tag1, tag2, tag3"
              data-i18n-placeholder="asset_detail_modal.tags_placeholder"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 dark:border-gray-700 dark:bg-gray-800 dark:text-white"
            />
          </div>
        </div>
      </section>

      {/* ============== Tabs (bottom) ============== */}
      {/* Core Fields (the <section> above) + the editable collections
          (Characterizations, Related Assets, Permissions) + the read-only
          Discussion/History/Versions tabs are all one tab strip: the
          `AssetDetailTabs` Svelte island, mount()ed into this container by the
          script below (which drives it via the returned controller methods). */}
      <div id={`${modalId}-detail-tabs`}></div>
    </div>

    {/* ============== Footer ============== */}
    <div
      class="flex flex-wrap items-center justify-end gap-3 px-6 py-4 border-t border-gray-200 dark:border-gray-800"
    >
      {/* Change-type picker (HU-LI09) — edit mode only: saving an existing
          asset creates a NEW VERSION, and the chosen kind of change decides
          which digit of the semver label bumps. Hidden in create mode. */}
      <fieldset id={`${modalId}-change-type`} class="hidden mr-auto">
        <legend
          class="mb-1 text-xs font-medium text-gray-500 dark:text-gray-400"
          data-i18n="asset_detail_modal.change_type_label"
        >
          What kind of change is this?
        </legend>
        {/* Pills + live preview share one row so the footer stays 2 rows tall
            (legend on top). The preview shows previous → the label this save
            will create, with the bumping digit highlighted (recomputed on pill
            change). */}
        <div class="flex flex-wrap items-center gap-3">
          <div class="inline-flex items-center gap-1 rounded-full border border-gray-200 bg-gray-50 p-1 dark:border-gray-700 dark:bg-gray-800">
            {[
              { value: "patch", key: "asset_detail_modal.change_type_patch", label: "Patch", checked: true },
              { value: "minor", key: "asset_detail_modal.change_type_minor", label: "Minor", checked: false },
              { value: "major", key: "asset_detail_modal.change_type_major", label: "Major", checked: false },
            ].map((ct) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="change_type"
                  value={ct.value}
                  checked={ct.checked}
                  class="peer sr-only"
                />
                <span
                  class="inline-block rounded-full px-3 py-1 text-xs font-semibold text-gray-500 transition-colors peer-checked:bg-indigo-600 peer-checked:text-white dark:text-gray-400"
                  data-i18n={ct.key}
                >{ct.label}</span>
              </label>
            ))}
          </div>
          <div
            id={`${modalId}-version-preview`}
            class="flex items-center gap-2 font-mono text-sm"
            aria-live="polite"
          >
            <span data-prev class="text-gray-400 line-through decoration-gray-300 dark:text-gray-500 dark:decoration-gray-600"></span>
            <span aria-hidden="true" class="text-indigo-500 font-bold">→</span>
            <span data-next class="font-semibold text-gray-800 dark:text-gray-100"></span>
          </div>
        </div>
      </fieldset>
      <button
        type="button"
        data-modal-close={modalId}
        class="rounded-lg px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800"
        data-i18n="common.cancel"
      >
        Cancel
      </button>
      <button
        id={`${modalId}-submit`}
        type="submit"
        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50"
        data-i18n="common.save"
      >
        Save
      </button>
    </div>
  </form>
</dialog>

{/* ============== Discard-changes confirmation ============== */}
{/* A second, stacked dialog — Cancel/X/Esc on the main dialog route through
    requestClose() below, which opens this one instead of closing outright
    whenever a slice (core/chars/related/related_inits/permissions) has
    unsaved edits. Native <dialog> only lets Esc dismiss the topmost modal, so
    it can safely stack on top of the still-open edit dialog. */}
<dialog
  id={`${modalId}-discard-confirm`}
  class="rounded-2xl p-6 w-[420px] max-w-full bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 backdrop:bg-black/60 backdrop:backdrop-blur-sm"
>
  <h3 class="text-base font-bold text-gray-900 dark:text-white" data-i18n="asset_detail_modal.discard_title">
    Discard changes?
  </h3>
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400" data-i18n="asset_detail_modal.discard_message">
    You have unsaved changes. If you leave now, they will be lost.
  </p>
  <div class="mt-5 flex justify-end gap-3">
    <button
      type="button"
      id={`${modalId}-discard-keep`}
      class="rounded-lg px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800"
      data-i18n="asset_detail_modal.discard_keep_editing"
    >
      Keep editing
    </button>
    <button
      type="button"
      id={`${modalId}-discard-confirm-btn`}
      class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700"
      data-i18n="asset_detail_modal.discard_confirm"
    >
      Discard changes
    </button>
  </div>
</dialog>

<script>
  /* ============================================================
     AssetDetailModal — runtime orchestration.
     Bound to the dialog with id="asset-detail-modal" emitted by this
     component. We use the literal id (not define:vars) so the script can
     be statically hoisted by Astro/Vite.
     ============================================================ */
  import { createAsset, createAssetVersion, updateAsset, getAsset, bumpVersionLabel } from "@/lib/assets";
  import type { ChangeType } from "@/types/api";
  import { isFavorite, setFavorite } from "@/lib/favorites";
  import { getUser } from "@/lib/auth";
  import { mount, tick } from "svelte";
  import AssetDetailTabs from "@/components/svelte/AssetDetailTabs.svelte";
  import { mountHistory } from "@/lib/history";
  import { mountVersions } from "@/lib/versions";
  import { ALL_DETAIL_SECTIONS } from "@/lib/assetSections";
  import { createStatusBanner } from "@/lib/statusBanner";

  const modalId = "asset-detail-modal";

  (() => {
    const dialog = document.getElementById(modalId) as HTMLDialogElement | null;
    if (!dialog) return;
    const form = document.getElementById(`${modalId}-form`) as HTMLFormElement;
    const idField = document.getElementById(`${modalId}-id`) as HTMLInputElement;
    const nameField = document.getElementById(`${modalId}-name`) as HTMLInputElement;
    const categorySel = document.getElementById(`${modalId}-category`) as HTMLSelectElement;
    const statusSel = document.getElementById(`${modalId}-status-select`) as HTMLSelectElement;
    const descField = document.getElementById(`${modalId}-description`) as HTMLTextAreaElement;
    const refField = document.getElementById(`${modalId}-reference`) as HTMLInputElement;
    const tagsField = document.getElementById(`${modalId}-tags`) as HTMLInputElement;
    const titleEl = document.getElementById(`${modalId}-title-text`) as HTMLElement;
    const titleNameEl = document.getElementById(`${modalId}-title-name`) as HTMLElement;
    const versionBadge = document.getElementById(`${modalId}-version`) as HTMLElement;
    const changeTypeFieldset = document.getElementById(`${modalId}-change-type`) as HTMLFieldSetElement;
    const statusBanner = document.getElementById(`${modalId}-status`) as HTMLElement;
    const submitBtn = document.getElementById(`${modalId}-submit`) as HTMLButtonElement;
    const favBtn = document.getElementById(`${modalId}-fav`) as HTMLButtonElement;
    const favSvg = favBtn?.querySelector("svg") as SVGElement;
    const discardDialog = document.getElementById(`${modalId}-discard-confirm`) as HTMLDialogElement | null;
    const discardKeepBtn = document.getElementById(`${modalId}-discard-keep`) as HTMLButtonElement;
    const discardConfirmBtn = document.getElementById(`${modalId}-discard-confirm-btn`) as HTMLButtonElement;

    // ── Small helpers ──────────────────────────────────────────────────────
    const tr = (key: string, fallback: string): string => {
      try {
        const lang = localStorage.getItem("lang") || "en";
        const w = window as any;
        if (typeof w.t === "function") return w.t(key, lang) || fallback;
      } catch { /* non-fatal */ }
      return fallback;
    };

    // Closable + self-dismissing (5s) — shared with the catalog modal and the
    // profile page so every inline "save confirmation" banner behaves the same.
    const status = createStatusBanner(statusBanner, "mx-6 mt-4 rounded-lg p-3 text-sm");
    const showStatus = status.show;
    const clearStatus = status.clear;

    // Shared by the submit payload and the "has this changed?" snapshot below
    // so the two never drift out of sync with each other.
    function buildCorePayload() {
      return {
        name: nameField.value.trim(),
        description: descField.value.trim() || undefined,
        category: categorySel.value || undefined,
        reference: refField.value.trim() || undefined,
        status: statusSel.value,
        tags: tagsField.value
          ? tagsField.value.split(",").map((t) => t.trim()).filter(Boolean)
          : undefined,
        is_active: true,
      };
    }

    let editingAssetId: number | null = null;
    // The loaded asset's version label — drives the "old → new" preview.
    let currentVersionLabel = "1.0.0";
    // Snapshot of the core-field payload as last loaded/saved — lets submit
    // detect "nothing to save" instead of firing a no-op PUT.
    let originalCoreSnapshot: string | null = null;
    // Favorite state. Edit mode toggles immediately (a per-user preference
    // orthogonal to the draft); create mode stages the bit until the id exists.
    let favoriteOn = false;

    // ── Version preview ("v1.2.0 → v1.3.0", bumping digit highlighted) ─────
    const versionPreview = document.getElementById(`${modalId}-version-preview`) as HTMLElement;
    const HIGHLIGHT_CLASSES = [
      "font-bold", "text-indigo-600", "dark:text-indigo-400",
      "bg-indigo-50", "dark:bg-indigo-500/20", "rounded", "px-1",
    ];
    const DIGIT_INDEX: Record<ChangeType, number> = { major: 0, minor: 1, patch: 2 };

    function selectedChangeType(): ChangeType {
      const checked = form.querySelector<HTMLInputElement>('input[name="change_type"]:checked');
      return (checked?.value as ChangeType) || "patch";
    }

    function renderVersionPreview() {
      if (!versionPreview) return;
      const prevEl = versionPreview.querySelector("[data-prev]") as HTMLElement;
      const nextEl = versionPreview.querySelector("[data-next]") as HTMLElement;
      if (!prevEl || !nextEl) return;
      const changeType = selectedChangeType();
      const nextLabel = bumpVersionLabel(currentVersionLabel, changeType);
      prevEl.textContent = `v${currentVersionLabel}`;
      // Rebuild the new label digit-by-digit so the bumping one stands out.
      nextEl.replaceChildren(document.createTextNode("v"));
      nextLabel.split(".").forEach((digit, i) => {
        if (i > 0) nextEl.appendChild(document.createTextNode("."));
        const span = document.createElement("span");
        span.textContent = digit;
        if (i === DIGIT_INDEX[changeType]) span.classList.add(...HIGHLIGHT_CLASSES);
        nextEl.appendChild(span);
      });
    }

    // The pills live in the always-rendered footer — bind once.
    form.querySelectorAll<HTMLInputElement>('input[name="change_type"]').forEach((radio) => {
      radio.addEventListener("change", renderVersionPreview);
    });

    // ── Shared tabs (core / chars / related / permissions / …) ─────────────
    // The tabs are the `AssetDetailTabs` Svelte island; mount() returns the
    // component's exported controller methods (loadOptions/loadChars/hydrate/
    // flush/reset/…), so the orchestration below is unchanged from the vanilla
    // widget it replaces.
    const tabsRoot = document.getElementById(`${modalId}-detail-tabs`) as HTMLElement;
    // Which tab is active — drives the tab-aware footer (below) in edit mode.
    // Only the Characterizations tab versions; Related/Permissions/Core Fields
    // save their own slice in place; Discussion/History/Versions have no
    // footer Save button — Discussion is fully interactive but saves inline
    // (Foro's own Post/Answer buttons), History/Versions are pure read-only.
    type DetailTab = "core" | "chars" | "related" | "related_inits" | "permissions" | "discussion" | "history" | "versions";
    const READONLY_TABS: DetailTab[] = ["discussion", "history", "versions"];
    let activeDetailTab: DetailTab = "core";
    const coreInputs = [nameField, categorySel, statusSel];
    const tabs = mount(AssetDetailTabs, {
      target: tabsRoot,
      props: {
        idPrefix: modalId,
        mode: "modal",
        onError: (m: string) => showStatus(m, "error"),
        onTabChange: (name: DetailTab) => {
          activeDetailTab = name;
          // Tab-scoped save only applies in edit mode — create mode saves
          // everything together, so Core Fields' inputs stay required no
          // matter which tab is active (set once in resetForm) and the footer
          // keeps its own plain "Save" the whole time.
          if (editingAssetId != null) {
            // Core Fields' required inputs would otherwise block submitting
            // from a different (hidden) tab — only require them while that
            // tab is actually active, mirroring how the other tabs save
            // independently.
            for (const f of coreInputs) if (f) f.required = name === "core";
            paintFooterForTab(name);
          }
        },
      },
    });

    // The Core Fields <section> (built as static markup above, with its own
    // inputs/validation/save payload already wired below) is re-parented into
    // the island's "core" tab panel right after mount — same DOM node, same
    // event listeners, just relocated into the tab flow.
    const coreSection = document.getElementById(`${modalId}-core-section`) as HTMLElement;
    const coreTabTarget = document.getElementById(`${modalId}-core`) as HTMLElement | null;
    if (coreSection && coreTabTarget) coreTabTarget.appendChild(coreSection);

    // Footer is tab-aware in edit mode: the change-type picker + version
    // preview + "Save new version" belong to the Characterizations tab (the
    // only versioned slice); Core Fields/Related/Permissions hide them and
    // relabel the save button, saving just that slice in place;
    // Discussion/History/Versions are read-only — the Save button is hidden
    // entirely (Cancel/close only).
    function paintFooterForTab(tab: DetailTab) {
      if (READONLY_TABS.includes(tab)) {
        changeTypeFieldset?.classList.add("hidden");
        submitBtn.classList.add("hidden");
        return;
      }
      submitBtn.classList.remove("hidden");
      if (tab === "chars") {
        changeTypeFieldset?.classList.remove("hidden");
        submitBtn.setAttribute("data-i18n", "asset_detail_modal.save_new_version");
        submitBtn.textContent = tr("asset_detail_modal.save_new_version", "Save new version");
        renderVersionPreview();
      } else {
        changeTypeFieldset?.classList.add("hidden");
        const SAVE_LABELS: Record<string, [string, string]> = {
          core: ["asset_detail_modal.save_core", "Save core fields"],
          related: ["asset_detail_modal.save_related", "Save related assets"],
          related_inits: ["asset_detail_modal.save_related_inits", "Save related initiatives"],
          permissions: ["asset_detail_modal.save_permissions", "Save permissions"],
        };
        const [key, fallback] = SAVE_LABELS[tab];
        submitBtn.setAttribute("data-i18n", key);
        submitBtn.textContent = tr(key, fallback);
      }
    }

    // Discussion/History/Versions reuse the same controllers/island the
    // gallery detail modal uses (History/Versions read-only; Discussion fully
    // interactive). They self-hook the modal's open trigger (which carries
    // data-asset-id), so one call each suffices; Discussion self-mounts via
    // the nested Foro island in AssetDetailTabs.
    mountHistory({ modalId });
    mountVersions({ modalId, sections: ALL_DETAIL_SECTIONS });

    // ── Core Fields pending-change highlight ────────────────────────────────
    // Core Fields lives here (not in the Svelte island), so it tracks + paints
    // its own "differs from baseline" state and just reports the summary
    // (tabs.setCoreDirty) for the tab strip's dot. Live on every keystroke —
    // not only when "Keep editing" fires — so the highlight is always accurate.
    const CORE_FIELD_ENTRIES: [HTMLElement, string][] = [
      [nameField, "name"],
      [categorySel, "category"],
      [statusSel, "status"],
      [descField, "description"],
      [refField, "reference"],
      [tagsField, "tags"],
    ];
    function coreChangedFields(): HTMLElement[] {
      const baseline = originalCoreSnapshot ? (JSON.parse(originalCoreSnapshot) as Record<string, unknown>) : {};
      const current = buildCorePayload() as Record<string, unknown>;
      return CORE_FIELD_ENTRIES.filter(
        ([, key]) => JSON.stringify(current[key]) !== JSON.stringify(baseline[key]),
      ).map(([el]) => el);
    }
    function updateCoreHighlight() {
      const changed = new Set(coreChangedFields());
      for (const [el] of CORE_FIELD_ENTRIES) {
        el.classList.toggle("ring-2", changed.has(el));
        el.classList.toggle("ring-amber-400", changed.has(el));
      }
      tabs.setCoreDirty(changed.size > 0);
    }
    for (const [el] of CORE_FIELD_ENTRIES) {
      el.addEventListener("input", updateCoreHighlight);
      el.addEventListener("change", updateCoreHighlight);
    }

    // ── Favorite star ───────────────────────────────────────────────────────
    function paintFavorite() {
      if (!favBtn || !favSvg) return;
      favBtn.setAttribute("aria-pressed", String(favoriteOn));
      favSvg.setAttribute("fill", favoriteOn ? "currentColor" : "none");
      favBtn.classList.toggle("text-yellow-400", favoriteOn);
      favBtn.classList.toggle("text-gray-400", !favoriteOn);
      const key = favoriteOn ? "asset_detail_modal.favorite_remove" : "asset_detail_modal.favorite_add";
      favBtn.setAttribute("data-i18n-title", key);
      favBtn.title = tr(key, favoriteOn ? "Remove from favorites" : "Add to favorites");
    }

    favBtn?.addEventListener("click", async () => {
      const user = getUser() as any;
      if (!user?.id && user?.id !== 0) return;

      if (!editingAssetId) {
        favoriteOn = !favoriteOn;
        paintFavorite();
        return;
      }
      const next = !favoriteOn;
      favoriteOn = next;
      paintFavorite();
      try {
        await setFavorite(Number(user.id), editingAssetId, next);
      } catch {
        favoriteOn = !next; // revert
        paintFavorite();
        showStatus(tr("asset_detail_modal.error_favorite", "Could not update favorite."), "error");
      }
    });

    // ── Reset / open / close ──────────────────────────────────────────────
    function resetForm() {
      form.reset(); // also re-checks the default "patch" change-type radio
      idField.value = "";
      editingAssetId = null;
      // Baseline for hasUnsavedChanges() in create mode — the blank form
      // right after reset. openEdit() overwrites this with the loaded
      // asset's real snapshot once fetched.
      originalCoreSnapshot = JSON.stringify(buildCorePayload());
      currentVersionLabel = "1.0.0";
      favoriteOn = false;
      paintFavorite();
      tabs.reset();
      versionBadge?.classList.add("hidden");
      changeTypeFieldset?.classList.add("hidden");
      activeDetailTab = "core";
      // The modal always opens on the Core Fields tab, so its inputs start
      // required; onTabChange relaxes/reinstates this as the user switches tabs.
      for (const f of coreInputs) if (f) f.required = true;
      // A read-only tab may have hidden the Save button on the previous open.
      submitBtn.classList.remove("hidden");
      // Create mode saves plainly; edit mode re-labels per the active tab.
      submitBtn.setAttribute("data-i18n", "common.save");
      submitBtn.textContent = tr("common.save", "Save");
      // Category is only locked while editing an existing asset (its
      // characterization set is keyed off it) — free again for a fresh create.
      categorySel.disabled = false;
      // Create mode has no asset yet — title stays plain "New Asset".
      titleNameEl.textContent = "";
      clearStatus();
      updateCoreHighlight(); // clears any leftover ring from the previous open
    }

    // Appends ": <name>" right after the title text, in the same run so it
    // inherits the h3's font/size — edit mode only (create mode has no name yet).
    function setTitleName(name: string) {
      titleNameEl.textContent = name ? `: ${name}` : "";
    }

    async function openCreate() {
      resetForm();
      titleEl.setAttribute("data-i18n", "asset_detail_modal.title_create");
      titleEl.textContent = tr("asset_detail_modal.title_create", "New Asset");
      dialog.showModal();
      tabs.loadOptions(); // non-blocking; composer dropdowns fill as data arrives
    }

    async function openEdit(assetId: number | string) {
      resetForm();
      editingAssetId = Number(assetId);
      titleEl.setAttribute("data-i18n", "asset_detail_modal.title_edit");
      titleEl.textContent = tr("asset_detail_modal.title_edit", "Edit Asset");
      // The category drives which characterization spec set applies to this
      // asset — changing it on an existing asset would orphan its already-
      // saved characterizations, so it's locked for the lifetime of the asset.
      categorySel.disabled = true;
      // The modal always opens on the Core Fields tab — paint its footer
      // (plain "Save core fields", no change-type picker). Switching tabs
      // repaints via onTabChange.
      paintFooterForTab("core");
      dialog.showModal();

      const user = getUser() as any;
      if (user?.id || user?.id === 0) {
        isFavorite(Number(user.id), editingAssetId).then((on) => {
          favoriteOn = on;
          paintFavorite();
        });
      }

      try {
        const asset = await getAsset(editingAssetId);
        idField.value = String(asset.id ?? "");
        nameField.value = asset.name ?? "";
        // "Edit Asset: <name>" once the asset is known.
        setTitleName(asset.name ?? "");
        descField.value = asset.description ?? "";
        refField.value = asset.reference ?? "";
        // Tolerate legacy/seeded rows that stored the bare status code
        // (e.g. `IN_USE`) without the list_items `N-` sort-prefix.
        const resolveStatusValue = (raw: string): string => {
          if (!raw) return "";
          if ([...statusSel.options].some((o) => o.value === raw)) return raw;
          const opt = [...statusSel.options].find(
            (o) => o.value.replace(/^\d+-/, "") === raw,
          );
          return opt?.value ?? raw;
        };
        statusSel.value = resolveStatusValue(asset.status ?? "");
        tagsField.value = Array.isArray(asset.tags)
          ? asset.tags.join(", ")
          : (asset.tags ?? "");
        categorySel.value = asset.category ?? "";
        currentVersionLabel = asset.current_version ?? "1.0.0";
        if (versionBadge) {
          versionBadge.textContent = `v${currentVersionLabel}`;
          versionBadge.classList.remove("hidden");
        }
        renderVersionPreview();
        // Baseline for the Core Fields "did anything actually change?" check.
        originalCoreSnapshot = JSON.stringify(buildCorePayload());
        updateCoreHighlight(); // fields were set programmatically — no input/change events fired

        // Load + seed all three detail tabs (chars/relations/permissions).
        await tabs.hydrate(editingAssetId, asset.category ?? "");
      } catch (e) {
        showStatus(
          e instanceof Error ? e.message : tr("asset_detail_modal.error_load", "Could not load asset."),
          "error",
        );
      }
    }

    function closeModal() {
      dialog.close();
      resetForm();
    }

    // Which tabs (in display order) have a slice that hasn't been saved yet.
    // Each tab already tracks its own dirty state for the tab-scoped save
    // flow — this just reads them in order instead of re-deriving anything.
    // Discussion/History/Versions never stage anything (Discussion saves
    // inline, the other two are read-only), so they're never in this list.
    function pendingTabs(): DetailTab[] {
      const pending: DetailTab[] = [];
      if (JSON.stringify(buildCorePayload()) !== originalCoreSnapshot) pending.push("core");
      if (tabs.charsDirty()) pending.push("chars");
      if (tabs.relationsDirty()) pending.push("related");
      if (tabs.initsDirty()) pending.push("related_inits");
      if (tabs.permissionsDirty()) pending.push("permissions");
      return pending;
    }

    function hasUnsavedChanges(): boolean {
      const favoriteChanged = !editingAssetId && favoriteOn; // create mode only — edit mode saves it immediately
      return pendingTabs().length > 0 || favoriteChanged;
    }

    // Cancel / X / Esc all route here instead of closing outright: pending
    // edits get a confirmation stop, same as a plain close when there's
    // nothing to lose.
    function requestClose() {
      if (hasUnsavedChanges()) {
        discardDialog?.showModal();
      } else {
        closeModal();
      }
    }

    // "Keep editing": jump to the first tab with a pending change and draw
    // the eye to it — the tab strip's amber dot (always live) plus this
    // one-time focus/scroll are the "resalte" the user asked for.
    discardKeepBtn?.addEventListener("click", async () => {
      discardDialog?.close();
      const [firstPending] = pendingTabs();
      if (!firstPending) return;
      tabs.activateTab(firstPending);
      await tick(); // let Svelte un-hide the target panel before focusing/scrolling into it
      if (firstPending === "core") {
        coreChangedFields()[0]?.focus();
      } else {
        tabs.focusFirstPending();
      }
    });
    discardConfirmBtn?.addEventListener("click", () => {
      discardDialog?.close();
      closeModal();
    });

    // ── Wire global "data-modal-open" / "data-modal-close" buttons ────────
    document.addEventListener("click", (e) => {
      const target = e.target.closest?.(`[data-modal-open="${modalId}"]`);
      if (target) {
        e.preventDefault();
        const mode = target.dataset.assetMode || "create";
        const assetId = target.dataset.assetId;
        if (mode === "edit" && assetId) openEdit(assetId);
        else openCreate();
      }
      const closer = e.target.closest?.(`[data-modal-close="${modalId}"]`);
      if (closer) {
        e.preventDefault();
        requestClose();
      }
    });

    // Close on ESC (native) leaves the form populated; reset on subsequent open.
    dialog.addEventListener("cancel", (e) => {
      e.preventDefault();
      requestClose();
    });

    // ── Category change → reload the dynamic characterization fields ───────
    categorySel.addEventListener("change", () => {
      tabs.loadChars(categorySel.value);
    });

    // ── Submit ────────────────────────────────────────────────────────────
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      clearStatus();

      try {
        let assetId: number;
        let savedMsg = tr("asset_detail_modal.saved", "Asset saved.");
        // Set instead of performing the save when the active tab has nothing
        // staged to persist — clicking Save on an untouched tab shouldn't
        // fire a no-op write (and, for Characteristics, shouldn't bump the
        // version for a snapshot identical to the one already saved).
        let noChanges = false;
        if (editingAssetId) {
          // Tab-scoped save (matches the Related/Permissions convention): only
          // the active tab's slice persists. What gets VERSIONED is the
          // characterization set (HU-LI09) — a Characterizations save bumps
          // `current_version` and snapshots the set under the new label. Core
          // Fields/Related/Permissions save their own slice in place, no
          // version bump. Discussion/History/Versions are read-only (no
          // reachable Save button).
          assetId = editingAssetId;
          if (activeDetailTab === "core") {
            const payload = buildCorePayload();
            if (JSON.stringify(payload) === originalCoreSnapshot) {
              noChanges = true;
            } else {
              await updateAsset(assetId, payload);
              savedMsg = tr("asset_detail_modal.core_saved", "Core fields saved.");
              // The title mirrors the asset's name — keep it in sync with
              // whatever was just saved instead of requiring a reload to see it.
              setTitleName(payload.name);
              originalCoreSnapshot = JSON.stringify(payload);
              updateCoreHighlight();
            }
          } else if (activeDetailTab === "chars") {
            // A spec's `required` flag (from the category's specifications
            // table) must have a value before this slice can save — mirrors
            // the Propose page's required-characterization gate, since
            // charSnapshot() would otherwise just silently drop a blank
            // required field the same way it drops an optional one.
            if (!tabs.validateChars()) {
              showStatus(
                tr("asset_detail_modal.characterization_required", "Please fill the required characterization fields."),
                "error",
              );
              submitBtn.disabled = false;
              return;
            }
            if (!tabs.charsDirty()) {
              noChanges = true;
            } else {
              const changeType = (new FormData(form).get("change_type") || "patch") as ChangeType;
              const saved = await createAssetVersion(assetId, {
                change_type: changeType,
                values: tabs.charSnapshot(),
              });
              savedMsg = tr(
                "asset_detail_modal.version_saved",
                "Asset saved as new version.",
              ).replace("{version}", saved.current_version ?? "");
              // Advance the "previous → next" baseline so a second version save
              // in the same sitting (no reload) previews from the label we just
              // created, not the one that was current when the modal opened.
              currentVersionLabel = saved.current_version ?? currentVersionLabel;
              if (versionBadge) versionBadge.textContent = `v${currentVersionLabel}`;
              renderVersionPreview();
              // createAssetVersion persists directly (no tabs.flush()), so
              // reseed the dirty-check baseline ourselves — otherwise
              // charsDirty() (and hasUnsavedChanges()) would keep reporting
              // this slice as pending forever after a successful save.
              tabs.commitCharsBaseline();
            }
          } else if (
            activeDetailTab === "related" ||
            activeDetailTab === "related_inits" ||
            activeDetailTab === "permissions"
          ) {
            // Related Assets / Related Inits / Permissions persist TOGETHER
            // (only Characterizations stays an isolated, versioned slice).
            // Saving just the active tab and skipping the other two used to
            // silently drop whatever was staged on them — e.g. add a related
            // asset, switch to Related Inits to add one there too, hit Save:
            // only the tab you were looking at actually reached the server.
            if (!tabs.relationsDirty() && !tabs.initsDirty() && !tabs.permissionsDirty()) {
              noChanges = true;
            } else {
              await tabs.flush(assetId, { skipChars: true });
              savedMsg =
                activeDetailTab === "related"
                  ? tr("asset_detail_modal.related_saved", "Related assets saved.")
                  : activeDetailTab === "related_inits"
                    ? tr("asset_detail_modal.related_inits_saved", "Related initiatives saved.")
                    : tr("asset_detail_modal.permissions_saved", "Permissions saved.");
            }
          }
        } else {
          // Create mode is unversioned and saves everything together (core +
          // every staged tab) regardless of which tab happens to be active —
          // the new asset starts at 1.0.0. There's no "nothing to save" case
          // here — a brand-new asset always has at least its required fields.
          if (!tabs.validateChars()) {
            tabs.activateTab("chars");
            showStatus(
              tr("asset_detail_modal.characterization_required", "Please fill the required characterization fields."),
              "error",
            );
            submitBtn.disabled = false;
            return;
          }
          const saved = await createAsset(buildCorePayload());
          assetId = Number(saved.id);
          await tabs.flush(assetId);
        }

        // 3. Favorite (create mode only — edit mode toggles immediately).
        if (!editingAssetId && favoriteOn) {
          const user = getUser() as any;
          if (user?.id || user?.id === 0) {
            try {
              await setFavorite(Number(user.id), assetId, true);
            } catch { /* non-fatal — asset itself saved fine */ }
          }
        }

        if (noChanges) {
          showStatus(tr("asset_detail_modal.no_changes", "No changes to save."), "info");
          submitBtn.disabled = false;
        } else {
          showStatus(savedMsg, "ok");
          if (editingAssetId) {
            // Edit mode: stay open on whatever tab the user is on — the message
            // confirms the save, editing continues uninterrupted. The list
            // behind the modal picks up the change whenever it's next loaded.
            submitBtn.disabled = false;
          } else {
            // Create mode: the new asset doesn't exist in the list yet, so
            // close + reload to reveal it.
            setTimeout(() => {
              closeModal();
              window.location.reload();
            }, 400);
          }
        }
      } catch (err) {
        showStatus(
          err instanceof Error ? err.message : tr("asset_detail_modal.error_save", "Could not save asset."),
          "error",
        );
        submitBtn.disabled = false;
      }
    });
  })();
</script>

<style is:global>
  /* Keep the dialog free of native UA padding when we manage it ourselves. */
  #asset-detail-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
</style>
